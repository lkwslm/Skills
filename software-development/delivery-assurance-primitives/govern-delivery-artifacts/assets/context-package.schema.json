{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-package.schema.json",
  "type": "object",
  "required": ["package_id", "level", "version", "content_hash", "sources", "dependencies", "read_scope", "write_scope", "created_at"],
  "additionalProperties": false,
  "properties": {
    "package_id": {"type": "string", "minLength": 1}, "level": {"type": "string", "enum": ["L0", "L1", "L2", "brownfield-task"]}, "version": {"type": "string", "minLength": 1}, "content_hash": {"type": "string", "minLength": 8},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["artifact_id", "version", "content_hash"], "additionalProperties": false, "properties": {"artifact_id": {"type": "string"}, "version": {"type": "string"}, "content_hash": {"type": "string", "minLength": 8}}}},
    "dependencies": {"type": "array", "items": {"type": "string"}}, "read_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "write_scope": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": "string", "format": "date-time"}, "canonicalization_version": {"type": "string"}
  }
}
