{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "type": "object",
  "required": ["evidence_id", "attempt_id", "commit_hash", "artifact_hashes", "runner", "operating_system", "tool_versions", "started_at", "ended_at", "command", "exit_code", "raw_log_path", "raw_log_hash", "test_selector", "passed", "failed", "skipped", "skip_reasons", "skip_approval_refs", "requirement_ids", "test_ids", "unverified_items", "valid_until", "invalidation_conditions"],
  "additionalProperties": false,
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "commit_hash": {"type": "string", "minLength": 8},
    "artifact_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 8}},
    "runner": {"type": "string", "minLength": 1}, "operating_system": {"type": "string", "minLength": 1}, "tool_versions": {"type": "object", "minProperties": 1},
    "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"}, "command": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer"},
    "raw_log_path": {"type": "string", "minLength": 1}, "raw_log_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "test_selector": {"type": "string", "minLength": 1},
    "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0},
    "skip_reasons": {"type": "array", "items": {"type": "string"}}, "skip_approval_refs": {"type": "array", "items": {"type": "string"}},
    "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "test_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unverified_items": {"type": "array", "items": {"type": "string"}}, "valid_until": {"type": ["string", "null"], "format": "date-time"}, "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
