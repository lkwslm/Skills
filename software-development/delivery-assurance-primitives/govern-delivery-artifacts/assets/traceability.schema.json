{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traceability.schema.json",
  "type": "object",
  "required": ["nodes", "edges", "required_paths"],
  "additionalProperties": false,
  "properties": {
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "version"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "exemption_approval": {"type": "string"}}}},
    "edges": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["from", "to", "relation", "source_version", "created_by"], "additionalProperties": false, "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "relation": {"type": "string", "minLength": 1}, "source_version": {"type": "string", "minLength": 1}, "created_by": {"type": "string", "minLength": 1}}}},
    "required_paths": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["start", "via_types", "end_type"], "additionalProperties": false, "properties": {"start": {"type": "string", "minLength": 1}, "via_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "end_type": {"type": "string", "minLength": 1}}}}
  }
}
