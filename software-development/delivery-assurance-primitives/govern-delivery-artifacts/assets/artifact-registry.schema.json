{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-registry.schema.json",
  "type": "object",
  "required": ["artifacts"],
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "authority_uri", "authority_kind", "owner_role", "writer", "version", "content_hash", "derived_from", "status", "created_at", "validated_at"],
        "additionalProperties": true,
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "authority_uri": {"type": "string", "minLength": 1},
          "authority_kind": {"type": "string", "enum": ["repository", "spec-tool", "external", "runtime"]},
          "owner_role": {"type": "string", "minLength": 1},
          "writer": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "minLength": 8},
          "derived_from": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
          "status": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "format": "date-time"},
          "validated_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["artifact_id", "version", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 8}
      }
    }
  }
}
