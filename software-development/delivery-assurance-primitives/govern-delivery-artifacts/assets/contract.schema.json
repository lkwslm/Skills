{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract.schema.json",
  "type": "object",
  "required": ["contract_id", "version", "epoch", "status", "owner", "consumers", "schema_uri", "error_model", "idempotency", "ordering", "timeout", "retry", "compatibility_window", "test_ids", "approval_id"],
  "additionalProperties": false,
  "properties": {
    "contract_id": {"type": "string", "pattern": "^CONTRACT-[A-Za-z0-9-]+$"},
    "version": {"type": "string", "minLength": 1},
    "epoch": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "reviewed", "frozen", "superseded", "retired"]},
    "owner": {"type": "string", "minLength": 1},
    "consumers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "schema_uri": {"type": "string", "minLength": 1},
    "error_model": {"type": "string", "minLength": 1},
    "idempotency": {"type": "string", "minLength": 1},
    "ordering": {"type": "string", "minLength": 1},
    "timeout": {"type": "string", "minLength": 1},
    "retry": {"type": "string", "minLength": 1},
    "compatibility_window": {"type": "string", "minLength": 1},
    "test_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TEST-[A-Za-z0-9-]+$"}},
    "approval_id": {"type": "string", "minLength": 1}
  }
}
