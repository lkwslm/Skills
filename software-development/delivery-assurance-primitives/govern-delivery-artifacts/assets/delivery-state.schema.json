{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-state.schema.json",
  "type": "object",
  "required": ["suite", "objects", "transitions"],
  "additionalProperties": false,
  "properties": {
    "suite": {"type": "string", "enum": ["greenfield", "brownfield"]},
    "objects": {"type": "array", "items": {"type": "object", "required": ["object_id", "kind", "state"], "additionalProperties": false, "properties": {"object_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["greenfield", "brownfield", "task", "contract"]}, "state": {"type": "string", "minLength": 1}, "parent_id": {"type": "string"}}}},
    "transitions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["object_id", "old_state", "new_state", "actor", "at", "input_versions", "evidence_refs", "gate_result"], "additionalProperties": false, "properties": {"object_id": {"type": "string", "minLength": 1}, "old_state": {"type": "string", "minLength": 1}, "new_state": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "at": {"type": "string", "format": "date-time"}, "input_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "gate_result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]}}}}
  }
}
